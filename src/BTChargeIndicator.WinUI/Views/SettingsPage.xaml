<Page
    x:Class="BTChargeIndicator.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="28" Padding="32" MaxWidth="1000" HorizontalAlignment="Center">
            <StackPanel Spacing="6">
                <TextBlock x:Name="SettingsTitleText" Text="Settings" FontSize="30" FontWeight="SemiBold" />
                <TextBlock x:Name="SettingsDescriptionText"
                           Text="Application preferences and device behavior."
                           FontSize="14" Opacity="0.72" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Name="MonitoringTitleText" Text="Monitoring" FontSize="18"
                           FontWeight="SemiBold" Margin="0,0,0,2" />
                <StackPanel Spacing="8">
                    <Border Padding="18" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="RefreshIntervalTitleText" Text="Refresh interval" FontWeight="SemiBold" />
                                <TextBlock x:Name="RefreshHelpText"
                                           Text="Choose how often the dashboard checks Bluetooth devices automatically."
                                           TextWrapping="Wrap" Opacity="0.72" />
                            </StackPanel>
                            <ComboBox x:Name="RefreshIntervalComboBox" Grid.Column="1" Width="220" SelectedIndex="1">
                                <ComboBoxItem Tag="30" />
                                <ComboBoxItem Tag="60" />
                                <ComboBoxItem Tag="300" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Padding="18" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="LowBatteryThresholdTitleText" Text="Mark battery as low at"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="LowBatteryThresholdDescriptionText"
                                           Text="Show a low-battery status when a device reaches this level."
                                           TextWrapping="Wrap" Opacity="0.72" />
                            </StackPanel>
                            <ComboBox x:Name="LowBatteryThresholdComboBox" Grid.Column="1" Width="220" SelectedIndex="2">
                                <ComboBoxItem Tag="10" />
                                <ComboBoxItem Tag="15" />
                                <ComboBoxItem Tag="20" />
                                <ComboBoxItem Tag="25" />
                                <ComboBoxItem Tag="30" />
                                <ComboBoxItem Tag="40" />
                                <ComboBoxItem Tag="50" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Name="NotificationsTitleText" Text="Notifications" FontSize="18"
                           FontWeight="SemiBold" Margin="0,0,0,2" />
                <StackPanel Spacing="8">
                    <Border Padding="18" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="LowBatteryNotificationsTitleText" Text="Low battery"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="LowBatteryNotificationsDescriptionText"
                                           Text="Notify when a connected device reaches the low battery threshold."
                                           TextWrapping="Wrap" Opacity="0.72" />
                            </StackPanel>
                            <ToggleSwitch x:Name="LowBatteryNotificationsToggle" Grid.Column="1"
                                          Width="48" OffContent="" OnContent=""
                                          VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <Border Padding="18" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="ConnectionNotificationsTitleText" Text="Device connections"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="ConnectionNotificationsDescriptionText"
                                           Text="Notify when a device connects or disconnects."
                                           TextWrapping="Wrap" Opacity="0.72" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ConnectionNotificationsToggle" Grid.Column="1"
                                          Width="48" OffContent="" OnContent=""
                                          VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Name="GeneralTitleText" Text="General" FontSize="18"
                           FontWeight="SemiBold" Margin="0,0,0,2" />
                <Border Padding="18" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="LanguageTitleText" Text="Language" FontWeight="SemiBold" />
                            <TextBlock x:Name="LanguageDescriptionText" Text="Choose the language used by the app."
                                       TextWrapping="Wrap" Opacity="0.72" />
                        </StackPanel>
                        <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="220" SelectedIndex="0">
                            <ComboBoxItem Tag="0" />
                            <ComboBoxItem Tag="1" />
                            <ComboBoxItem Tag="2" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" Opacity="0.78" />
                <Button x:Name="SaveButton" Content="Save" Click="SaveButton_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
