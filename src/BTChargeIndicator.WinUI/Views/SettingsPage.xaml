<Page
    x:Class="BTChargeIndicator.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="24" Padding="32">
            <StackPanel Spacing="6">
                <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" />
                <TextBlock
                    Text="Application preferences and device behavior."
                    FontSize="14"
                    Opacity="0.72" />
            </StackPanel>
            <Border
                Padding="24"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Settings pages are coming next" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock
                        Text="The settings experience will be migrated in focused steps after the shared runtime and platform services are available to this host."
                        TextWrapping="Wrap"
                        MaxWidth="720"
                        Opacity="0.78" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
