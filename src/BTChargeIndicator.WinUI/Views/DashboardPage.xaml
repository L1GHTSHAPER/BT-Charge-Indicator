<Page
    x:Class="BTChargeIndicator.WinUI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="24" Padding="32">
            <StackPanel Spacing="6">
                <TextBlock Text="Dashboard" FontSize="30" FontWeight="SemiBold" />
                <TextBlock
                    Text="Your Bluetooth devices and battery status in one place."
                    FontSize="14"
                    Opacity="0.72" />
            </StackPanel>

            <Border
                Padding="28"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Your devices will appear here" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock
                        Text="The WinUI 3 shell is ready. The next step is connecting this window to the shared Bluetooth runtime so the dashboard displays the same device state as the existing tray application."
                        TextWrapping="Wrap"
                        MaxWidth="720"
                        Opacity="0.78" />
                    <InfoBar
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="Bluetooth runtime integration is not connected yet"
                        Message="No device data is being simulated or displayed until the shared runtime is connected." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
